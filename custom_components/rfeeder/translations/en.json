    "add_schedule": {
      "name": "Add feeding schedule",
      "description": "Adds a feeding schedule stored on the device (runs autonomously, even without HA).",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "Feeder device id"
        },
        "time": {
          "name": "Time",
          "description": "Feeding time in local time (HH:MM). Alternatively hour/minute in UTC."
        },
        "hour": {
          "name": "Hour (UTC)",
          "description": "Only if 'Time' is empty: hour in UTC (0-23)"
        },
        "minute": {
          "name": "Minute (UTC)",
          "description": "Only if 'Time' is empty: minute in UTC (0-59)"
        },
        "weekdays": {
          "name": "Weekdays",
          "description": "List like [\"mon\",\"tue\",\"fri\"]; empty = one-time. Bitmask int (0-127) also accepted."
        },
        "enabled": {
          "name": "Enabled",
          "description": "Schedule is active"
        },
        "tray_compartment_index": {
          "name": "Tray compartment",
          "description": "Tray compartment index (1-4)"
        },
        "feed_duration_minutes": {
          "name": "Duration",
          "description": "Feeding duration in minutes"
        },
        "heat_before_feeding": {
          "name": "Preheat",
          "description": "Heat before feeding"
        }
      }
    },
    "remove_schedule": {
      "name": "Remove feeding schedule",
      "description": "Removes a feeding schedule by id.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "Feeder device id"
        },
        "schedule_id": {
          "name": "Schedule id",
          "description": "Id of the schedule (see next scheduled feeding attributes)"
        }
      }
    },
    "set_schedule_enabled": {
      "name": "Enable/disable schedule",
      "description": "Enables or disables an existing feeding schedule.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "Feeder device id"
        },
        "schedule_id": {
          "name": "Schedule id",
          "description": "Id of the schedule"
        },
        "enabled": {
          "name": "Enabled",
          "description": "Enable or disable"
        }
      }
    },
    "sync_weekly_plan": {
      "name": "Sync weekly plan",
      "description": "Replaces the on-device feeding schedules with the given plan (used by the weekly card).",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "Feeder device id (optional if only one device)"
        },
        "plan": {
          "name": "Plan",
          "description": "List of entries: {compartment, time (local HH:MM), weekdays [mon..sun], feed_duration_minutes, heat_before_feeding, enabled}"
        },
        "replace": {
          "name": "Replace",
          "description": "Replace all existing schedules (default: on)"
        }
      }
    }
